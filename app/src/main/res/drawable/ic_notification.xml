<?xml version="1.0" encoding="utf-8"?>
<!-- Simple paw-print icon for the status bar notification.
     Android uses only the alpha channel for notification icons, so this
     must be a solid monochrome shape — no gradients or multicolor fills. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Main paw pad -->
    <path
        android:pathData="M12,10 A5,5 0 1 0 22,10 A5,5 0 1 0 12,10 Z"
        android:fillColor="#FFFFFF" />

    <!-- Toe 1 (top-left) -->
    <path
        android:pathData="M6,5 A2.5,2.5 0 1 0 11,5 A2.5,2.5 0 1 0 6,5 Z"
        android:fillColor="#FFFFFF" />

    <!-- Toe 2 (top-center-left) -->
    <path
        android:pathData="M11,3 A2,2 0 1 0 15,3 A2,2 0 1 0 11,3 Z"
        android:fillColor="#FFFFFF" />

    <!-- Toe 3 (top-center-right) -->
    <path
        android:pathData="M15,3 A2,2 0 1 0 19,3 A2,2 0 1 0 15,3 Z"
        android:fillColor="#FFFFFF" />

    <!-- Toe 4 (top-right) -->
    <path
        android:pathData="M18,5 A2.5,2.5 0 1 0 23,5 A2.5,2.5 0 1 0 18,5 Z"
        android:fillColor="#FFFFFF" />

</vector>
